{
  "name": "Frank Light",
  "type": "light",
  "colors": {
    "foreground": "#4D3A0B",
    "input.background": "#ebe8dd",
    "input.foreground": "#4D3A0B",
    "input.placeholderForeground": "#e4dfce",
    "inputOption.activeBorder": "#AD830180",
    "badge.foreground": "#FFFCF0",
    "badge.background": "#AD8301",
    "progressBar.background": "#AD8301",
    "button.background": "#AD8301",
    "button.foreground": "#4D3A0B",
    "button.hoverBackground": "#AD830190",
    "dropdown.background": "#ebe8dd",
    "dropdown.foreground": "#4D3A0B",
    "dropdown.border": "#f6f2e5",
    "focusBorder": "#AD830180",
    "selection.background": "#AD830140",
    "editor.background": "#FFFCF0",
    "editor.foreground": "#4D3A0B",
    "sideBar.background": "#FFFCF0",
    "sideBar.border": "#f6f2e5",
    "activityBar.background": "#FFFCF0",
    "activityBar.foreground": "#4D3A0B",
    "activityBar.inactiveForeground": "#b8ae94",
    "statusBar.background": "#FFFCF0",
    "statusBar.foreground": "#4D3A0B",
    "titleBar.activeBackground": "#FFFCF0",
    "titleBar.activeForeground": "#4D3A0B",
    "editorLineNumber.foreground": "#e4dfce",
    "editorLineNumber.activeForeground": "#b8ae94",
    "editor.lineHighlightBackground": "#f6f2e5",
    "editorIndentGuide.background": "#f6f2e5",
    "editorIndentGuide.activeBackground": "#b8ae94",
    "list.hoverBackground": "#f6f2e5",
    "list.activeSelectionBackground": "#f6f2e5",
    "list.activeSelectionForeground": "#4D3A0B",
    "tab.activeBackground": "#f6f2e5",
    "tab.activeForeground": "#4D3A0B",
    "tab.inactiveBackground": "#FFFCF0",
    "tab.inactiveForeground": "#b8ae94",
    "tab.border": "#f6f2e5",
    "breadcrumb.foreground": "#b8ae94",
    "breadcrumb.focusForeground": "#4D3A0B",
    "widget.shadow": "#00000040",
    "quickInput.background": "#fffefa",
    "terminal.background": "#FFFCF0",
    "terminal.foreground": "#4D3A0B"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b8ae94",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#4D3A0B"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#b8ae94"
      }
    }
  ]
}