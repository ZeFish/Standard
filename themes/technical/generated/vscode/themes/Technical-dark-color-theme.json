{
  "name": "Technical Dark",
  "type": "dark",
  "colors": {
    "foreground": "#9e7f5b",
    "input.background": "#383b41",
    "input.foreground": "#9e7f5b",
    "input.placeholderForeground": "#2a2a2c",
    "inputOption.activeBorder": "#00000080",
    "badge.foreground": "#1d2027",
    "badge.background": "#000000",
    "progressBar.background": "#000000",
    "button.background": "#000000",
    "button.foreground": "#9e7f5b",
    "button.hoverBackground": "#00000090",
    "dropdown.background": "#383b41",
    "dropdown.foreground": "#9e7f5b",
    "dropdown.border": "#27282b",
    "focusBorder": "#00000080",
    "selection.background": "#00000040",
    "editor.background": "#1d2027",
    "editor.foreground": "#9e7f5b",
    "sideBar.background": "#1d2027",
    "sideBar.border": "#27282b",
    "activityBar.background": "#1d2027",
    "activityBar.foreground": "#9e7f5b",
    "activityBar.inactiveForeground": "#443d37",
    "statusBar.background": "#1d2027",
    "statusBar.foreground": "#9e7f5b",
    "titleBar.activeBackground": "#1d2027",
    "titleBar.activeForeground": "#9e7f5b",
    "editorLineNumber.foreground": "#2a2a2c",
    "editorLineNumber.activeForeground": "#443d37",
    "editor.lineHighlightBackground": "#1a1d23",
    "editorIndentGuide.background": "#27282b",
    "editorIndentGuide.activeBackground": "#443d37",
    "list.hoverBackground": "#26272b",
    "list.activeSelectionBackground": "#26272b",
    "list.activeSelectionForeground": "#9e7f5b",
    "tab.activeBackground": "#26272b",
    "tab.activeForeground": "#9e7f5b",
    "tab.inactiveBackground": "#1d2027",
    "tab.inactiveForeground": "#443d37",
    "tab.border": "#27282b",
    "breadcrumb.foreground": "#443d37",
    "breadcrumb.focusForeground": "#9e7f5b",
    "widget.shadow": "#00000040",
    "quickInput.background": "#26272b",
    "terminal.background": "#1d2027",
    "terminal.foreground": "#9e7f5b"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#443d37",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#27a06c"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#da702c"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#9e7f5b"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#da702c"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#da702c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#da702c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#8caaee",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#d69a00"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#27a06c"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#8caaee"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#8caaee"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#443d37"
      }
    }
  ]
}