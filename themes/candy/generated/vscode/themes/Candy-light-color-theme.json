{
  "name": "Candy Light",
  "type": "light",
  "colors": {
    "foreground": "#391f2c",
    "input.background": "#ebd1d4",
    "input.foreground": "#391f2c",
    "input.placeholderForeground": "#e1c6ca",
    "inputOption.activeBorder": "#ed409680",
    "badge.foreground": "#ffe3e6",
    "badge.background": "#ed4096",
    "progressBar.background": "#ed4096",
    "button.background": "#ed4096",
    "button.foreground": "#391f2c",
    "button.hoverBackground": "#ed409690",
    "dropdown.background": "#ebd1d4",
    "dropdown.foreground": "#391f2c",
    "dropdown.border": "#f5d9dd",
    "focusBorder": "#ed409680",
    "selection.background": "#ed409640",
    "editor.background": "#ffe3e6",
    "editor.foreground": "#391f2c",
    "sideBar.background": "#ffe3e6",
    "sideBar.border": "#f5d9dd",
    "activityBar.background": "#ffe3e6",
    "activityBar.foreground": "#391f2c",
    "activityBar.inactiveForeground": "#b0959c",
    "statusBar.background": "#ffe3e6",
    "statusBar.foreground": "#391f2c",
    "titleBar.activeBackground": "#ffe3e6",
    "titleBar.activeForeground": "#391f2c",
    "editorLineNumber.foreground": "#e1c6ca",
    "editorLineNumber.activeForeground": "#b0959c",
    "editor.lineHighlightBackground": "#f5d9dd",
    "editorIndentGuide.background": "#f5d9dd",
    "editorIndentGuide.activeBackground": "#b0959c",
    "list.hoverBackground": "#f5d9dd",
    "list.activeSelectionBackground": "#f5d9dd",
    "list.activeSelectionForeground": "#391f2c",
    "tab.activeBackground": "#f5d9dd",
    "tab.activeForeground": "#391f2c",
    "tab.inactiveBackground": "#ffe3e6",
    "tab.inactiveForeground": "#b0959c",
    "tab.border": "#f5d9dd",
    "breadcrumb.foreground": "#b0959c",
    "breadcrumb.focusForeground": "#391f2c",
    "widget.shadow": "#00000040",
    "quickInput.background": "#fff5f6",
    "terminal.background": "#ffe3e6",
    "terminal.foreground": "#391f2c"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b0959c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#65c67d"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#ef852e"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#391f2c"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ef852e"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ef852e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#ef852e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3f9fe8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#e1c34b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#65c67d"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#3f9fe8"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#3f9fe8"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#b0959c"
      }
    }
  ]
}