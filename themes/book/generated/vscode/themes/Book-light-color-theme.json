{
  "name": "Book Light",
  "type": "light",
  "colors": {
    "foreground": "#282726",
    "input.background": "#eae9e5",
    "input.foreground": "#282726",
    "input.placeholderForeground": "#deddd9",
    "inputOption.activeBorder": "#a1231480",
    "badge.foreground": "#fefdf9",
    "badge.background": "#a12314",
    "progressBar.background": "#a12314",
    "button.background": "#a12314",
    "button.foreground": "#282726",
    "button.hoverBackground": "#a1231490",
    "dropdown.background": "#eae9e5",
    "dropdown.foreground": "#282726",
    "dropdown.border": "#f3f2ee",
    "focusBorder": "#a1231480",
    "selection.background": "#a1231440",
    "editor.background": "#fefdf9",
    "editor.foreground": "#282726",
    "sideBar.background": "#fefdf9",
    "sideBar.border": "#f3f2ee",
    "activityBar.background": "#fefdf9",
    "activityBar.foreground": "#282726",
    "activityBar.inactiveForeground": "#a8a7a5",
    "statusBar.background": "#fefdf9",
    "statusBar.foreground": "#282726",
    "titleBar.activeBackground": "#fefdf9",
    "titleBar.activeForeground": "#282726",
    "editorLineNumber.foreground": "#deddd9",
    "editorLineNumber.activeForeground": "#a8a7a5",
    "editor.lineHighlightBackground": "#f3f2ee",
    "editorIndentGuide.background": "#f3f2ee",
    "editorIndentGuide.activeBackground": "#a8a7a5",
    "list.hoverBackground": "#f3f2ee",
    "list.activeSelectionBackground": "#f3f2ee",
    "list.activeSelectionForeground": "#282726",
    "tab.activeBackground": "#f3f2ee",
    "tab.activeForeground": "#282726",
    "tab.inactiveBackground": "#fefdf9",
    "tab.inactiveForeground": "#a8a7a5",
    "tab.border": "#f3f2ee",
    "breadcrumb.foreground": "#a8a7a5",
    "breadcrumb.focusForeground": "#282726",
    "widget.shadow": "#00000040",
    "quickInput.background": "#fffefd",
    "terminal.background": "#fefdf9",
    "terminal.foreground": "#282726"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a8a7a5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#5e9d80"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#c86a3d"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#282726"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#c86a3d"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c86a3d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#c86a3d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3b6d90",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#c2a84a"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#5e9d80"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#3b6d90"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#3b6d90"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#a8a7a5"
      }
    }
  ]
}