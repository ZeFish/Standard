{
  "name": "Dev Dark",
  "type": "dark",
  "colors": {
    "foreground": "#dbcd93",
    "input.background": "#373736",
    "input.foreground": "#dbcd93",
    "input.placeholderForeground": "#2f2e27",
    "inputOption.activeBorder": "#c7a54080",
    "badge.foreground": "#1c1c1b",
    "badge.background": "#c7a540",
    "progressBar.background": "#c7a540",
    "button.background": "#c7a540",
    "button.foreground": "#dbcd93",
    "button.hoverBackground": "#c7a54090",
    "dropdown.background": "#373736",
    "dropdown.foreground": "#dbcd93",
    "dropdown.border": "#2b2a25",
    "focusBorder": "#c7a54080",
    "selection.background": "#c7a54040",
    "editor.background": "#1c1c1b",
    "editor.foreground": "#dbcd93",
    "sideBar.background": "#1c1c1b",
    "sideBar.border": "#2b2a25",
    "activityBar.background": "#1c1c1b",
    "activityBar.foreground": "#dbcd93",
    "activityBar.inactiveForeground": "#55513f",
    "statusBar.background": "#1c1c1b",
    "statusBar.foreground": "#dbcd93",
    "titleBar.activeBackground": "#1c1c1b",
    "titleBar.activeForeground": "#dbcd93",
    "editorLineNumber.foreground": "#2f2e27",
    "editorLineNumber.activeForeground": "#55513f",
    "editor.lineHighlightBackground": "#191918",
    "editorIndentGuide.background": "#2b2a25",
    "editorIndentGuide.activeBackground": "#55513f",
    "list.hoverBackground": "#292823",
    "list.activeSelectionBackground": "#292823",
    "list.activeSelectionForeground": "#dbcd93",
    "tab.activeBackground": "#292823",
    "tab.activeForeground": "#dbcd93",
    "tab.inactiveBackground": "#1c1c1b",
    "tab.inactiveForeground": "#55513f",
    "tab.border": "#2b2a25",
    "breadcrumb.foreground": "#55513f",
    "breadcrumb.focusForeground": "#dbcd93",
    "widget.shadow": "#00000040",
    "quickInput.background": "#292823",
    "terminal.background": "#1c1c1b",
    "terminal.foreground": "#dbcd93"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#55513f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#919300"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#c48745"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#dbcd93"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#c48745"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c48745",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#c48745",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#277d9e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#c7a540"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#919300"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#277d9e"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#277d9e"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#55513f"
      }
    }
  ]
}