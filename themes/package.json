{
  "name": "@stnd/themes",
  "version": "0.14.0",
  "type": "module",
  "author": "Francis Fontaine",
  "license": "MIT",
  "main": "./macos/index.module.js",
  "exports": {
    ".": "./macos/index.module.js",
    "./*/*.scss": "./*/*.scss",
    "./*": "./*/index.module.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node _scripts/build.js && node -e \"if (!process.env.TURBO_HASH) require('child_process').execSync('pnpm --filter standard-garden build', {stdio: 'inherit'})\"",
    "build:themes": "node _scripts/build.js",
    "dev": "node _scripts/watch.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.148.0"
  }
}
