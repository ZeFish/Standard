{
  "name": "Claude Light",
  "type": "light",
  "colors": {
    "foreground": "#27201a",
    "input.background": "#e7e5e1",
    "input.foreground": "#27201a",
    "input.placeholderForeground": "#dbd8d4",
    "inputOption.activeBorder": "#cb644180",
    "badge.foreground": "#fbf9f5",
    "badge.background": "#cb6441",
    "progressBar.background": "#cb6441",
    "button.background": "#cb6441",
    "button.foreground": "#27201a",
    "button.hoverBackground": "#cb644190",
    "dropdown.background": "#e7e5e1",
    "dropdown.foreground": "#27201a",
    "dropdown.border": "#f0eeea",
    "focusBorder": "#cb644180",
    "selection.background": "#cb644140",
    "editor.background": "#fbf9f5",
    "editor.foreground": "#27201a",
    "sideBar.background": "#fbf9f5",
    "sideBar.border": "#f0eeea",
    "activityBar.background": "#fbf9f5",
    "activityBar.foreground": "#27201a",
    "activityBar.inactiveForeground": "#a6a29d",
    "statusBar.background": "#fbf9f5",
    "statusBar.foreground": "#27201a",
    "titleBar.activeBackground": "#fbf9f5",
    "titleBar.activeForeground": "#27201a",
    "editorLineNumber.foreground": "#dbd8d4",
    "editorLineNumber.activeForeground": "#a6a29d",
    "editor.lineHighlightBackground": "#f0eeea",
    "editorIndentGuide.background": "#f0eeea",
    "editorIndentGuide.activeBackground": "#a6a29d",
    "list.hoverBackground": "#f0eeea",
    "list.activeSelectionBackground": "#f0eeea",
    "list.activeSelectionForeground": "#27201a",
    "tab.activeBackground": "#f0eeea",
    "tab.activeForeground": "#27201a",
    "tab.inactiveBackground": "#fbf9f5",
    "tab.inactiveForeground": "#a6a29d",
    "tab.border": "#f0eeea",
    "breadcrumb.foreground": "#a6a29d",
    "breadcrumb.focusForeground": "#27201a",
    "widget.shadow": "#00000040",
    "quickInput.background": "#fefdfc",
    "terminal.background": "#fbf9f5",
    "terminal.foreground": "#27201a"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a6a29d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#27201a"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#a6a29d"
      }
    }
  ]
}