{
  "name": "Claude Dark",
  "type": "dark",
  "colors": {
    "foreground": "#e1dddb",
    "input.background": "#3d3d3c",
    "input.foreground": "#e1dddb",
    "input.placeholderForeground": "#363534",
    "inputOption.activeBorder": "#d1705180",
    "badge.foreground": "#232221",
    "badge.background": "#d17051",
    "progressBar.background": "#d17051",
    "button.background": "#d17051",
    "button.foreground": "#e1dddb",
    "button.hoverBackground": "#d1705190",
    "dropdown.background": "#3d3d3c",
    "dropdown.foreground": "#e1dddb",
    "dropdown.border": "#323130",
    "focusBorder": "#d1705180",
    "selection.background": "#d1705140",
    "editor.background": "#232221",
    "editor.foreground": "#e1dddb",
    "sideBar.background": "#232221",
    "sideBar.border": "#323130",
    "activityBar.background": "#232221",
    "activityBar.foreground": "#e1dddb",
    "activityBar.inactiveForeground": "#5c5a59",
    "statusBar.background": "#232221",
    "statusBar.foreground": "#e1dddb",
    "titleBar.activeBackground": "#232221",
    "titleBar.activeForeground": "#e1dddb",
    "editorLineNumber.foreground": "#363534",
    "editorLineNumber.activeForeground": "#5c5a59",
    "editor.lineHighlightBackground": "#201f1e",
    "editorIndentGuide.background": "#323130",
    "editorIndentGuide.activeBackground": "#5c5a59",
    "list.hoverBackground": "#302f2e",
    "list.activeSelectionBackground": "#302f2e",
    "list.activeSelectionForeground": "#e1dddb",
    "tab.activeBackground": "#302f2e",
    "tab.activeForeground": "#e1dddb",
    "tab.inactiveBackground": "#232221",
    "tab.inactiveForeground": "#5c5a59",
    "tab.border": "#323130",
    "breadcrumb.foreground": "#5c5a59",
    "breadcrumb.focusForeground": "#e1dddb",
    "widget.shadow": "#00000040",
    "quickInput.background": "#302f2e",
    "terminal.background": "#232221",
    "terminal.foreground": "#e1dddb"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5c5a59",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#e1dddb"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#5c5a59"
      }
    }
  ]
}