{
  "name": "macOS Dark",
  "type": "dark",
  "colors": {
    "foreground": "#f5f5f7",
    "input.background": "#393939",
    "input.foreground": "#f5f5f7",
    "input.placeholderForeground": "#333334",
    "inputOption.activeBorder": "#0a84ff80",
    "badge.foreground": "#1e1e1e",
    "badge.background": "#0a84ff",
    "progressBar.background": "#0a84ff",
    "button.background": "#0a84ff",
    "button.foreground": "#f5f5f7",
    "button.hoverBackground": "#0a84ff90",
    "dropdown.background": "#393939",
    "dropdown.foreground": "#f5f5f7",
    "dropdown.border": "#2f2f2f",
    "focusBorder": "#0a84ff80",
    "selection.background": "#0a84ff40",
    "editor.background": "#1e1e1e",
    "editor.foreground": "#f5f5f7",
    "sideBar.background": "#1e1e1e",
    "sideBar.border": "#2f2f2f",
    "activityBar.background": "#1e1e1e",
    "activityBar.foreground": "#f5f5f7",
    "activityBar.inactiveForeground": "#5f5f5f",
    "statusBar.background": "#1e1e1e",
    "statusBar.foreground": "#f5f5f7",
    "titleBar.activeBackground": "#1e1e1e",
    "titleBar.activeForeground": "#f5f5f7",
    "editorLineNumber.foreground": "#333334",
    "editorLineNumber.activeForeground": "#5f5f5f",
    "editor.lineHighlightBackground": "#1b1b1b",
    "editorIndentGuide.background": "#2f2f2f",
    "editorIndentGuide.activeBackground": "#5f5f5f",
    "list.hoverBackground": "#2d2d2d",
    "list.activeSelectionBackground": "#2d2d2d",
    "list.activeSelectionForeground": "#f5f5f7",
    "tab.activeBackground": "#2d2d2d",
    "tab.activeForeground": "#f5f5f7",
    "tab.inactiveBackground": "#1e1e1e",
    "tab.inactiveForeground": "#5f5f5f",
    "tab.border": "#2f2f2f",
    "breadcrumb.foreground": "#5f5f5f",
    "breadcrumb.focusForeground": "#f5f5f7",
    "widget.shadow": "#00000040",
    "quickInput.background": "#2d2d2d",
    "terminal.background": "#1e1e1e",
    "terminal.foreground": "#f5f5f7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f5f5f",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#f5f5f7"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#5f5f5f"
      }
    }
  ]
}