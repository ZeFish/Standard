{
  "name": "Gallery Light",
  "type": "light",
  "colors": {
    "foreground": "#1c1c1c",
    "input.background": "#e6e6e6",
    "input.foreground": "#1c1c1c",
    "input.placeholderForeground": "#d9d9d9",
    "inputOption.activeBorder": "#00000080",
    "badge.foreground": "#fafafa",
    "badge.background": "#000000",
    "progressBar.background": "#000000",
    "button.background": "#000000",
    "button.foreground": "#1c1c1c",
    "button.hoverBackground": "#00000090",
    "dropdown.background": "#e6e6e6",
    "dropdown.foreground": "#1c1c1c",
    "dropdown.border": "#efefef",
    "focusBorder": "#00000080",
    "selection.background": "#00000040",
    "editor.background": "#fafafa",
    "editor.foreground": "#1c1c1c",
    "sideBar.background": "#fafafa",
    "sideBar.border": "#efefef",
    "activityBar.background": "#fafafa",
    "activityBar.foreground": "#1c1c1c",
    "activityBar.inactiveForeground": "#a1a1a1",
    "statusBar.background": "#fafafa",
    "statusBar.foreground": "#1c1c1c",
    "titleBar.activeBackground": "#fafafa",
    "titleBar.activeForeground": "#1c1c1c",
    "editorLineNumber.foreground": "#d9d9d9",
    "editorLineNumber.activeForeground": "#a1a1a1",
    "editor.lineHighlightBackground": "#efefef",
    "editorIndentGuide.background": "#efefef",
    "editorIndentGuide.activeBackground": "#a1a1a1",
    "list.hoverBackground": "#efefef",
    "list.activeSelectionBackground": "#efefef",
    "list.activeSelectionForeground": "#1c1c1c",
    "tab.activeBackground": "#efefef",
    "tab.activeForeground": "#1c1c1c",
    "tab.inactiveBackground": "#fafafa",
    "tab.inactiveForeground": "#a1a1a1",
    "tab.border": "#efefef",
    "breadcrumb.foreground": "#a1a1a1",
    "breadcrumb.focusForeground": "#1c1c1c",
    "widget.shadow": "#00000040",
    "quickInput.background": "#fdfdfd",
    "terminal.background": "#fafafa",
    "terminal.foreground": "#1c1c1c"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a1a1a1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#1c1c1c"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#a1a1a1"
      }
    }
  ]
}