{
  "name": "Contraste Élevé Dark",
  "type": "dark",
  "colors": {
    "foreground": "#ffffff",
    "input.background": "#1f1f1f",
    "input.foreground": "#ffffff",
    "input.placeholderForeground": "#191919",
    "inputOption.activeBorder": "#ffff0080",
    "badge.foreground": "#000000",
    "badge.background": "#ffff00",
    "progressBar.background": "#ffff00",
    "button.background": "#ffff00",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#ffff0090",
    "dropdown.background": "#1f1f1f",
    "dropdown.foreground": "#ffffff",
    "dropdown.border": "#141414",
    "focusBorder": "#ffff0080",
    "selection.background": "#ffff0040",
    "editor.background": "#000000",
    "editor.foreground": "#ffffff",
    "sideBar.background": "#000000",
    "sideBar.border": "#141414",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#ffffff",
    "activityBar.inactiveForeground": "#4d4d4d",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#ffffff",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#ffffff",
    "editorLineNumber.foreground": "#191919",
    "editorLineNumber.activeForeground": "#4d4d4d",
    "editor.lineHighlightBackground": "#000000",
    "editorIndentGuide.background": "#141414",
    "editorIndentGuide.activeBackground": "#4d4d4d",
    "list.hoverBackground": "#121212",
    "list.activeSelectionBackground": "#121212",
    "list.activeSelectionForeground": "#ffffff",
    "tab.activeBackground": "#121212",
    "tab.activeForeground": "#ffffff",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#4d4d4d",
    "tab.border": "#141414",
    "breadcrumb.foreground": "#4d4d4d",
    "breadcrumb.focusForeground": "#ffffff",
    "widget.shadow": "#00000040",
    "quickInput.background": "#121212",
    "terminal.background": "#000000",
    "terminal.foreground": "#ffffff"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4d4d4d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#4d4d4d"
      }
    }
  ]
}