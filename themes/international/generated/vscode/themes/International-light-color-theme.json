{
  "name": "International Light",
  "type": "light",
  "colors": {
    "foreground": "#000000",
    "input.background": "#000000",
    "input.foreground": "#000000",
    "input.placeholderForeground": "#000000",
    "inputOption.activeBorder": "#e0303080",
    "badge.foreground": "#000000",
    "badge.background": "#e03030",
    "progressBar.background": "#e03030",
    "button.background": "#e03030",
    "button.foreground": "#000000",
    "button.hoverBackground": "#e0303090",
    "dropdown.background": "#000000",
    "dropdown.foreground": "#000000",
    "dropdown.border": "#000000",
    "focusBorder": "#e0303080",
    "selection.background": "#e0303040",
    "editor.background": "#000000",
    "editor.foreground": "#000000",
    "sideBar.background": "#000000",
    "sideBar.border": "#000000",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#000000",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#000000",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#000000",
    "editorLineNumber.foreground": "#000000",
    "editorLineNumber.activeForeground": "#000000",
    "editor.lineHighlightBackground": "#000000",
    "editorIndentGuide.background": "#000000",
    "editorIndentGuide.activeBackground": "#000000",
    "list.hoverBackground": "#000000",
    "list.activeSelectionBackground": "#000000",
    "list.activeSelectionForeground": "#000000",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#000000",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#000000",
    "tab.border": "#000000",
    "breadcrumb.foreground": "#000000",
    "breadcrumb.focusForeground": "#000000",
    "widget.shadow": "#00000040",
    "quickInput.background": "#a6a6a6",
    "terminal.background": "#000000",
    "terminal.foreground": "#000000"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#e03030"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#e03030"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#e03030"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#e03030",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#e03030",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2b5aa0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#e03030"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e03030"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#2b5aa0"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#2b5aa0"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#000000"
      }
    }
  ]
}