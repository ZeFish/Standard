{
  "name": "International Dark",
  "type": "dark",
  "colors": {
    "foreground": "#ccc",
    "input.background": "#2e2e2e",
    "input.foreground": "#ccc",
    "input.placeholderForeground": "#242424",
    "inputOption.activeBorder": "#00000080",
    "badge.foreground": "#111111",
    "badge.background": "#000000",
    "progressBar.background": "#000000",
    "button.background": "#000000",
    "button.foreground": "#ccc",
    "button.hoverBackground": "#00000090",
    "dropdown.background": "#2e2e2e",
    "dropdown.foreground": "#ccc",
    "dropdown.border": "#202020",
    "focusBorder": "#00000080",
    "selection.background": "#00000040",
    "editor.background": "#111111",
    "editor.foreground": "#ccc",
    "sideBar.background": "#111111",
    "sideBar.border": "#202020",
    "activityBar.background": "#111111",
    "activityBar.foreground": "#ccc",
    "activityBar.inactiveForeground": "#494949",
    "statusBar.background": "#111111",
    "statusBar.foreground": "#ccc",
    "titleBar.activeBackground": "#111111",
    "titleBar.activeForeground": "#ccc",
    "editorLineNumber.foreground": "#242424",
    "editorLineNumber.activeForeground": "#494949",
    "editor.lineHighlightBackground": "#0f0f0f",
    "editorIndentGuide.background": "#202020",
    "editorIndentGuide.activeBackground": "#494949",
    "list.hoverBackground": "#1e1e1e",
    "list.activeSelectionBackground": "#1e1e1e",
    "list.activeSelectionForeground": "#ccc",
    "tab.activeBackground": "#1e1e1e",
    "tab.activeForeground": "#ccc",
    "tab.inactiveBackground": "#111111",
    "tab.inactiveForeground": "#494949",
    "tab.border": "#202020",
    "breadcrumb.foreground": "#494949",
    "breadcrumb.focusForeground": "#ccc",
    "widget.shadow": "#00000040",
    "quickInput.background": "#1e1e1e",
    "terminal.background": "#111111",
    "terminal.foreground": "#ccc"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#494949",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#ccc"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#494949"
      }
    }
  ]
}