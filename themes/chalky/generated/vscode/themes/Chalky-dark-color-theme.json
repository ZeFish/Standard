{
  "name": "Chalky Dark",
  "type": "dark",
  "colors": {
    "foreground": "#faf8f1",
    "input.background": "#545040",
    "input.foreground": "#faf8f1",
    "input.placeholderForeground": "#504b3a",
    "inputOption.activeBorder": "#d08a4980",
    "badge.foreground": "#3d3826",
    "badge.background": "#d08a49",
    "progressBar.background": "#d08a49",
    "button.background": "#d08a49",
    "button.foreground": "#faf8f1",
    "button.hoverBackground": "#d08a4990",
    "dropdown.background": "#545040",
    "dropdown.foreground": "#faf8f1",
    "dropdown.border": "#4c4736",
    "focusBorder": "#d08a4980",
    "selection.background": "#d08a4940",
    "editor.background": "#3d3826",
    "editor.foreground": "#faf8f1",
    "sideBar.background": "#3d3826",
    "sideBar.border": "#4c4736",
    "activityBar.background": "#3d3826",
    "activityBar.foreground": "#faf8f1",
    "activityBar.inactiveForeground": "#767263",
    "statusBar.background": "#3d3826",
    "statusBar.foreground": "#faf8f1",
    "titleBar.activeBackground": "#3d3826",
    "titleBar.activeForeground": "#faf8f1",
    "editorLineNumber.foreground": "#504b3a",
    "editorLineNumber.activeForeground": "#767263",
    "editor.lineHighlightBackground": "#373222",
    "editorIndentGuide.background": "#4c4736",
    "editorIndentGuide.activeBackground": "#767263",
    "list.hoverBackground": "#4a4534",
    "list.activeSelectionBackground": "#4a4534",
    "list.activeSelectionForeground": "#faf8f1",
    "tab.activeBackground": "#4a4534",
    "tab.activeForeground": "#faf8f1",
    "tab.inactiveBackground": "#3d3826",
    "tab.inactiveForeground": "#767263",
    "tab.border": "#4c4736",
    "breadcrumb.foreground": "#767263",
    "breadcrumb.focusForeground": "#faf8f1",
    "widget.shadow": "#00000040",
    "quickInput.background": "#4a4534",
    "terminal.background": "#3d3826",
    "terminal.foreground": "#faf8f1"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#767263",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#faf8f1"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#767263"
      }
    }
  ]
}