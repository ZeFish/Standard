{
  "name": "Reveal Light",
  "type": "light",
  "colors": {
    "foreground": "#212121",
    "input.background": "#e9e9e8",
    "input.foreground": "#212121",
    "input.placeholderForeground": "#dcdcdb",
    "inputOption.activeBorder": "#d6202c80",
    "badge.foreground": "#fdfdfc",
    "badge.background": "#d6202c",
    "progressBar.background": "#d6202c",
    "button.background": "#d6202c",
    "button.foreground": "#212121",
    "button.hoverBackground": "#d6202c90",
    "dropdown.background": "#e9e9e8",
    "dropdown.foreground": "#212121",
    "dropdown.border": "#f2f2f1",
    "focusBorder": "#d6202c80",
    "selection.background": "#d6202c40",
    "editor.background": "#fdfdfc",
    "editor.foreground": "#212121",
    "sideBar.background": "#fdfdfc",
    "sideBar.border": "#f2f2f1",
    "activityBar.background": "#fdfdfc",
    "activityBar.foreground": "#212121",
    "activityBar.inactiveForeground": "#a5a5a4",
    "statusBar.background": "#fdfdfc",
    "statusBar.foreground": "#212121",
    "titleBar.activeBackground": "#fdfdfc",
    "titleBar.activeForeground": "#212121",
    "editorLineNumber.foreground": "#dcdcdb",
    "editorLineNumber.activeForeground": "#a5a5a4",
    "editor.lineHighlightBackground": "#f2f2f1",
    "editorIndentGuide.background": "#f2f2f1",
    "editorIndentGuide.activeBackground": "#a5a5a4",
    "list.hoverBackground": "#f2f2f1",
    "list.activeSelectionBackground": "#f2f2f1",
    "list.activeSelectionForeground": "#212121",
    "tab.activeBackground": "#f2f2f1",
    "tab.activeForeground": "#212121",
    "tab.inactiveBackground": "#fdfdfc",
    "tab.inactiveForeground": "#a5a5a4",
    "tab.border": "#f2f2f1",
    "breadcrumb.foreground": "#a5a5a4",
    "breadcrumb.focusForeground": "#212121",
    "widget.shadow": "#00000040",
    "quickInput.background": "#fefefe",
    "terminal.background": "#fdfdfc",
    "terminal.foreground": "#212121"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a5a5a4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#212121"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#a5a5a4"
      }
    }
  ]
}