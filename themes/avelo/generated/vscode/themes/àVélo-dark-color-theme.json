{
  "name": "àVélo Dark",
  "type": "dark",
  "colors": {
    "foreground": "#e6ebe9",
    "input.background": "#2e3231",
    "input.foreground": "#e6ebe9",
    "input.placeholderForeground": "#272b2a",
    "inputOption.activeBorder": "#30d3ae80",
    "badge.foreground": "#121615",
    "badge.background": "#30d3ae",
    "progressBar.background": "#30d3ae",
    "button.background": "#30d3ae",
    "button.foreground": "#e6ebe9",
    "button.hoverBackground": "#30d3ae90",
    "dropdown.background": "#2e3231",
    "dropdown.foreground": "#e6ebe9",
    "dropdown.border": "#232726",
    "focusBorder": "#30d3ae80",
    "selection.background": "#30d3ae40",
    "editor.background": "#121615",
    "editor.foreground": "#e6ebe9",
    "sideBar.background": "#121615",
    "sideBar.border": "#232726",
    "activityBar.background": "#121615",
    "activityBar.foreground": "#e6ebe9",
    "activityBar.inactiveForeground": "#525655",
    "statusBar.background": "#121615",
    "statusBar.foreground": "#e6ebe9",
    "titleBar.activeBackground": "#121615",
    "titleBar.activeForeground": "#e6ebe9",
    "editorLineNumber.foreground": "#272b2a",
    "editorLineNumber.activeForeground": "#525655",
    "editor.lineHighlightBackground": "#101413",
    "editorIndentGuide.background": "#232726",
    "editorIndentGuide.activeBackground": "#525655",
    "list.hoverBackground": "#212524",
    "list.activeSelectionBackground": "#212524",
    "list.activeSelectionForeground": "#e6ebe9",
    "tab.activeBackground": "#212524",
    "tab.activeForeground": "#e6ebe9",
    "tab.inactiveBackground": "#121615",
    "tab.inactiveForeground": "#525655",
    "tab.border": "#232726",
    "breadcrumb.foreground": "#525655",
    "breadcrumb.focusForeground": "#e6ebe9",
    "widget.shadow": "#00000040",
    "quickInput.background": "#212524",
    "terminal.background": "#121615",
    "terminal.foreground": "#e6ebe9"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#525655",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#4cc38a"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#f0954a"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#e6ebe9"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#f0954a"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f0954a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#f0954a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#5b9cf0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#e3b341"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#4cc38a"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#5b9cf0"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#5b9cf0"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#525655"
      }
    }
  ]
}