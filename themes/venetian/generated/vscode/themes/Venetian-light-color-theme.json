{
  "name": "Venetian Light",
  "type": "light",
  "colors": {
    "foreground": "#2b1d12",
    "input.background": "#dfd5c4",
    "input.foreground": "#2b1d12",
    "input.placeholderForeground": "#d4cab8",
    "inputOption.activeBorder": "#7b3f0080",
    "badge.foreground": "#f2e8d5",
    "badge.background": "#7b3f00",
    "progressBar.background": "#7b3f00",
    "button.background": "#7b3f00",
    "button.foreground": "#2b1d12",
    "button.hoverBackground": "#7b3f0090",
    "dropdown.background": "#dfd5c4",
    "dropdown.foreground": "#2b1d12",
    "dropdown.border": "#e8decb",
    "focusBorder": "#7b3f0080",
    "selection.background": "#7b3f0040",
    "editor.background": "#f2e8d5",
    "editor.foreground": "#2b1d12",
    "sideBar.background": "#f2e8d5",
    "sideBar.border": "#e8decb",
    "activityBar.background": "#f2e8d5",
    "activityBar.foreground": "#2b1d12",
    "activityBar.inactiveForeground": "#a29787",
    "statusBar.background": "#f2e8d5",
    "statusBar.foreground": "#2b1d12",
    "titleBar.activeBackground": "#f2e8d5",
    "titleBar.activeForeground": "#2b1d12",
    "editorLineNumber.foreground": "#d4cab8",
    "editorLineNumber.activeForeground": "#a29787",
    "editor.lineHighlightBackground": "#e8decb",
    "editorIndentGuide.background": "#e8decb",
    "editorIndentGuide.activeBackground": "#a29787",
    "list.hoverBackground": "#e8decb",
    "list.activeSelectionBackground": "#e8decb",
    "list.activeSelectionForeground": "#2b1d12",
    "tab.activeBackground": "#e8decb",
    "tab.activeForeground": "#2b1d12",
    "tab.inactiveBackground": "#f2e8d5",
    "tab.inactiveForeground": "#a29787",
    "tab.border": "#e8decb",
    "breadcrumb.foreground": "#a29787",
    "breadcrumb.focusForeground": "#2b1d12",
    "widget.shadow": "#00000040",
    "quickInput.background": "#faf7f0",
    "terminal.background": "#f2e8d5",
    "terminal.foreground": "#2b1d12"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a29787",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#2b1d12"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2f4e6e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#c2a94b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#2f4e6e"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#2f4e6e"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#a29787"
      }
    }
  ]
}