{
  "name": "Venetian Dark",
  "type": "dark",
  "colors": {
    "foreground": "#e8d9bd",
    "input.background": "#372e27",
    "input.foreground": "#e8d9bd",
    "input.placeholderForeground": "#30261c",
    "inputOption.activeBorder": "#color-mix( in srgb, var(--color-dark-foreground) 25%, #b08a4b )80",
    "badge.foreground": "#1c120a",
    "badge.background": "color-mix( in srgb, var(--color-dark-foreground) 25%, #b08a4b )",
    "progressBar.background": "color-mix( in srgb, var(--color-dark-foreground) 25%, #b08a4b )",
    "button.background": "color-mix( in srgb, var(--color-dark-foreground) 25%, #b08a4b )",
    "button.foreground": "#e8d9bd",
    "button.hoverBackground": "#color-mix( in srgb, var(--color-dark-foreground) 25%, #b08a4b )90",
    "dropdown.background": "#372e27",
    "dropdown.foreground": "#e8d9bd",
    "dropdown.border": "#2c2218",
    "focusBorder": "#color-mix( in srgb, var(--color-dark-foreground) 25%, #b08a4b )80",
    "selection.background": "#color-mix( in srgb, var(--color-dark-foreground) 25%, #b08a4b )40",
    "editor.background": "#1c120a",
    "editor.foreground": "#e8d9bd",
    "sideBar.background": "#1c120a",
    "sideBar.border": "#2c2218",
    "activityBar.background": "#1c120a",
    "activityBar.foreground": "#e8d9bd",
    "activityBar.inactiveForeground": "#594e40",
    "statusBar.background": "#1c120a",
    "statusBar.foreground": "#e8d9bd",
    "titleBar.activeBackground": "#1c120a",
    "titleBar.activeForeground": "#e8d9bd",
    "editorLineNumber.foreground": "#30261c",
    "editorLineNumber.activeForeground": "#594e40",
    "editor.lineHighlightBackground": "#191009",
    "editorIndentGuide.background": "#2c2218",
    "editorIndentGuide.activeBackground": "#594e40",
    "list.hoverBackground": "#2a2017",
    "list.activeSelectionBackground": "#2a2017",
    "list.activeSelectionForeground": "#e8d9bd",
    "tab.activeBackground": "#2a2017",
    "tab.activeForeground": "#e8d9bd",
    "tab.inactiveBackground": "#1c120a",
    "tab.inactiveForeground": "#594e40",
    "tab.border": "#2c2218",
    "breadcrumb.foreground": "#594e40",
    "breadcrumb.focusForeground": "#e8d9bd",
    "widget.shadow": "#00000040",
    "quickInput.background": "#2a2017",
    "terminal.background": "#1c120a",
    "terminal.foreground": "#e8d9bd"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#594e40",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#e8d9bd"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#2f4e6e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#c2a94b"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#000000"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#2f4e6e"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#2f4e6e"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#594e40"
      }
    }
  ]
}