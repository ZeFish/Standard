{
  "name": "Pulp Dark",
  "type": "dark",
  "colors": {
    "foreground": "#e1d6c2",
    "input.background": "#2f2826",
    "input.foreground": "#e1d6c2",
    "input.placeholderForeground": "#281f1b",
    "inputOption.activeBorder": "#ffbe0080",
    "badge.foreground": "#130b08",
    "badge.background": "#ffbe00",
    "progressBar.background": "#ffbe00",
    "button.background": "#ffbe00",
    "button.foreground": "#e1d6c2",
    "button.hoverBackground": "#ffbe0090",
    "dropdown.background": "#2f2826",
    "dropdown.foreground": "#e1d6c2",
    "dropdown.border": "#231b17",
    "focusBorder": "#ffbe0080",
    "selection.background": "#ffbe0040",
    "editor.background": "#130b08",
    "editor.foreground": "#e1d6c2",
    "sideBar.background": "#130b08",
    "sideBar.border": "#231b17",
    "activityBar.background": "#130b08",
    "activityBar.foreground": "#e1d6c2",
    "activityBar.inactiveForeground": "#514840",
    "statusBar.background": "#130b08",
    "statusBar.foreground": "#e1d6c2",
    "titleBar.activeBackground": "#130b08",
    "titleBar.activeForeground": "#e1d6c2",
    "editorLineNumber.foreground": "#281f1b",
    "editorLineNumber.activeForeground": "#514840",
    "editor.lineHighlightBackground": "#110a07",
    "editorIndentGuide.background": "#231b17",
    "editorIndentGuide.activeBackground": "#514840",
    "list.hoverBackground": "#211915",
    "list.activeSelectionBackground": "#211915",
    "list.activeSelectionForeground": "#e1d6c2",
    "tab.activeBackground": "#211915",
    "tab.activeForeground": "#e1d6c2",
    "tab.inactiveBackground": "#130b08",
    "tab.inactiveForeground": "#514840",
    "tab.border": "#231b17",
    "breadcrumb.foreground": "#514840",
    "breadcrumb.focusForeground": "#e1d6c2",
    "widget.shadow": "#00000040",
    "quickInput.background": "#211915",
    "terminal.background": "#130b08",
    "terminal.foreground": "#e1d6c2"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#514840",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "variable",
      "settings": {
        "foreground": "#65c86b"
      }
    },
    {
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#ff7c00"
      }
    },
    {
      "scope": "variable.other.member",
      "settings": {
        "foreground": "#e1d6c2"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ff7c00"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ff7c00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#ff7c00",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#3b9cf6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#ffbe00"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#65c86b"
      }
    },
    {
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#3b9cf6"
      }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#3b9cf6"
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#514840"
      }
    }
  ]
}